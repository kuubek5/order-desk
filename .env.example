# Обов'язкові — згенеруйте ОКРЕМЕ значення для кожного ключа перед запуском.
# Кросплатформна команда (потрібен лише Python):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
# Fernet-ключ має бути саме 32-byte url-safe base64. Команда генерації:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Поле навмисно порожнє: застосунок не стартує, доки сюди не вставлено результат.
DB_ENCRYPTION_KEY=

# Опційні — на v0.1-v0.2 задавались тут, тепер основний спосіб — екран
# Налаштування (адмін), значення нижче лише bootstrap-фолбек, якщо
# Налаштування ще не заповнені
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=/app/credentials/service_account.json
DB_PATH=order_desk.db
EXPORT_FOLDER_PATH=/app/export
