# Обов'язково — без цих двох застосунок не стартує:
SESSION_SECRET_KEY=
DB_ENCRYPTION_KEY=

# Необов'язково — можна залишити пустими й задати пізніше через екран
# /settings (Google Sheet ID, Service Account JSON, IMAP). Задати тут
# має сенс тільки для першого запуску без адміна під рукою.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
