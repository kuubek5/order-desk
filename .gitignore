# License signing key (scripts/license_keygen.py) — never in git, ever.
# Ключ API kie.ai — читає scripts/kie_image.py, у git не потрапляє.
.kie_key

license_private_key.pem
*_private_key.pem

# Видані ключі активації клієнтів (журнал власника, не для git)
keys/
data/
# ...але не app/data: там лежать еталони цифр табло печей — це вихідний код
# проєкту, а не робочі дані машини (правило «data/ не в git» цілилось у
# %LOCALAPPDATA%-теки, не в пакет застосунку).
!app/data/
!app/data/**
export/

# Impeccable design-hook dedup cache (machine-local)
.impeccable/hook.cache.json

# Design references & session artefacts (big binaries / local-only)
screens/
refs_catalog/
*.bak_*
order_desk.db.bak_*
.devlogin
.devcookies

# Залишки від перейменування бази й тимчасові копії
*.db.stray-*
machine_frames/

# бекап caveman-compress (CLAUDE.md), не комітити
CLAUDE.md.original.md

# Копії бази, які застосунок робить сам (щомісячні + перед міграцією схеми).
# У них ЖИВІ дані цеху й зашифровані секрети — у git їм не місце.
backups/

# Логи dev-сервера (dev_restart.ps1)
dev*.out.log
dev*.err.log

# Демо-теки dev-сервера (STL-прев'ю на 8002)
dev_export/
dev_tech/
